# Local-only shared token. Spring Boot must send this value in X-Internal-Token.
INTERNAL_SERVICE_TOKEN=local-development-internal-token-2026

# DeepSeek generation. Keep the key blank in files and inject it at runtime only.
AI_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_TOTAL_TIMEOUT_SECONDS=110
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_RETRY_BASE_SECONDS=0.25
DEEPSEEK_RETRY_MAX_SECONDS=2

# Optional OpenAI-compatible generation. Select with AI_MODEL_PROVIDER when
# the service should use this slot as its deployment default.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
OPENAI_COMPATIBLE_CHAT_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_MAX_RETRIES=2
OPENAI_COMPATIBLE_RESPONSE_FORMAT=json_object
OPENAI_COMPATIBLE_TOKEN_LIMIT_FIELD=max_tokens
OPENAI_COMPATIBLE_SEND_TEMPERATURE=true

# Optional animation-only model. inherit keeps all existing behavior.
# Set openai_compatible and fill ALL three fields to override ANIMATION only.
# Base URL example: https://your-provider.example/v1 (NOT /chat/completions).
TUTOR_ANIMATION_MODEL_PROVIDER=inherit
TUTOR_ANIMATION_BASE_URL=
TUTOR_ANIMATION_API_KEY=
TUTOR_ANIMATION_MODEL=
TUTOR_ANIMATION_RESPONSE_FORMAT=json_object
TUTOR_ANIMATION_TOKEN_LIMIT_FIELD=max_tokens
TUTOR_ANIMATION_SEND_TEMPERATURE=false
TUTOR_ANIMATION_TIMEOUT_SECONDS=45
TUTOR_ANIMATION_MAX_RETRIES=1

# Approved Graph-RAG context service.
KNOWLEDGE_SERVICE_BASE_URL=http://localhost:8001
KNOWLEDGE_SERVICE_TIMEOUT_SECONDS=5
KNOWLEDGE_SERVICE_MAX_RELATED=8
KNOWLEDGE_SERVICE_MATCH_LIMIT=5

# Cycle 2 assessment file parsing. Must match the origin Spring puts in download_url.
BUSINESS_SERVICE_INTERNAL_BASE_URL=http://localhost:8080
ASSESSMENT_SOURCE_TIMEOUT_SECONDS=10
ASSESSMENT_SOURCE_MAX_FILE_BYTES=52428800
ASSESSMENT_SOURCE_MAX_TEXT_CHARS=60000
ASSESSMENT_SOURCE_MAX_PDF_PAGES=200
ASSESSMENT_PARSE_TOTAL_TIMEOUT_SECONDS=75

# Cycle 7 transient graph extraction/review. Source files are processed only in
# memory and are never written to ChromaDB or a local document store.
GRAPH_INGESTION_TOTAL_TIMEOUT_SECONDS=220
GRAPH_INGESTION_MAX_CANDIDATES=300

# Cycle 4 subjective/attachment grading suggestions. Spring owns final grades.
GRADING_TOTAL_TIMEOUT_SECONDS=75
GRADING_ATTACHMENT_TIMEOUT_SECONDS=10
GRADING_ATTACHMENT_MAX_FILES=5
GRADING_ATTACHMENT_MAX_FILE_BYTES=20971520
GRADING_ATTACHMENT_MAX_TOTAL_BYTES=52428800
GRADING_ATTACHMENT_MAX_TEXT_CHARS_PER_FILE=40000
GRADING_ATTACHMENT_MAX_TEXT_CHARS_TOTAL=60000
GRADING_ATTACHMENT_MAX_PDF_PAGES=100

# Cycle 3 Python sandbox. Provision this image explicitly; runtime requests
# fail closed and never pull an image automatically.
SANDBOX_DOCKER_COMMAND=docker
SANDBOX_PYTHON_IMAGE=python:3.11.15-alpine3.23

# Cycle 5 learning-memory embedding. Only learning_memory may be persisted.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1
OLLAMA_CHAT_MODEL=
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_TOTAL_TIMEOUT_SECONDS=50
OLLAMA_MAX_RETRIES=1
OLLAMA_RETRY_BASE_SECONDS=0.25
OLLAMA_RETRY_MAX_SECONDS=1
MEMORY_EMBEDDING_PROVIDER=disabled
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_TIMEOUT_SECONDS=10
MEMORY_TOTAL_TIMEOUT_SECONDS=15
CHROMA_PERSIST_DIR=D:\CodexEnvs\EducationAgent\chroma

# Cycle 7 bounded read-only Tutor Router. The hard implementation limit is two
# tool steps; FIXED remains the default request mode and fallback strategy.
TUTOR_ROUTER_MAX_STEPS=2
TUTOR_ROUTER_TOOL_TIMEOUT_SECONDS=5
TUTOR_ROUTER_TOTAL_TIMEOUT_SECONDS=30
TUTOR_GENERATION_TOTAL_TIMEOUT_SECONDS=110

# Cycle 6: private D -> Spring invocation telemetry. Values are summaries only;
# never put prompts, completions, identities, keys, or tokens in these settings.
MODEL_TELEMETRY_TIMEOUT_SECONDS=3
MODEL_TELEMETRY_MAX_RETRIES=2
MODEL_TELEMETRY_RETRY_BASE_SECONDS=0.1
MODEL_PRICING_VERSION=unconfigured-v1
MODEL_PRICING_CURRENCY=USD
MODEL_INPUT_MICROUNITS_PER_MILLION=0
MODEL_OUTPUT_MICROUNITS_PER_MILLION=0
# Enable Spring-owned model settings after applying business database migration V16.
AI_RUNTIME_SETTINGS_ENABLED=true
